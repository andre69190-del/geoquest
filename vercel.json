{
  "version": 2,
  "builds": [
    { "src": "index.html",      "use": "@vercel/static" },
    { "src": "landing.html",    "use": "@vercel/static" },
    { "src": "impressum.html",  "use": "@vercel/static" },
    { "src": "datenschutz.html","use": "@vercel/static" },
    { "src": "robots.txt",      "use": "@vercel/static" },
    { "src": "sitemap.xml",     "use": "@vercel/static" },
    { "src": "*.json",          "use": "@vercel/static" },
    { "src": "sw.js",           "use": "@vercel/static" },
    { "src": "manifest.json",   "use": "@vercel/static" },
    { "src": "icon.svg",        "use": "@vercel/static" },
    { "src": "cities_data.js",  "use": "@vercel/static" },
    { "src": "google1b9fe4381920a332.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/sw.js",              "dest": "/sw.js",              "headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "X-Content-Type-Options": "nosniff" } },
    { "src": "/manifest.json",      "dest": "/manifest.json",      "headers": { "Cache-Control": "no-cache", "X-Content-Type-Options": "nosniff" } },
    { "src": "/icon.svg",           "dest": "/icon.svg",           "headers": { "X-Content-Type-Options": "nosniff" } },
    { "src": "/cities_data.js",     "dest": "/cities_data.js",     "headers": { "X-Content-Type-Options": "nosniff" } },
    { "src": "/robots.txt",         "dest": "/robots.txt",         "headers": { "Content-Type": "text/plain" } },
    { "src": "/sitemap.xml",        "dest": "/sitemap.xml",        "headers": { "Content-Type": "application/xml" } },
    { "src": "/",                    "dest": "/landing.html",      "headers": { "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "strict-origin-when-cross-origin", "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()", "Strict-Transport-Security": "max-age=63072000; includeSubDomains" } },
    { "src": "/play",               "dest": "/index.html",         "headers": { "Cache-Control": "no-cache", "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "strict-origin-when-cross-origin", "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()", "Strict-Transport-Security": "max-age=63072000; includeSubDomains" } },
    { "src": "/landing.html",       "dest": "/landing.html",       "headers": { "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "strict-origin-when-cross-origin", "Strict-Transport-Security": "max-age=63072000; includeSubDomains" } },
    { "src": "/impressum.html",     "dest": "/impressum.html",     "headers": { "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "strict-origin-when-cross-origin", "Strict-Transport-Security": "max-age=63072000; includeSubDomains" } },
    { "src": "/datenschutz.html",   "dest": "/datenschutz.html",   "headers": { "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "strict-origin-when-cross-origin", "Strict-Transport-Security": "max-age=63072000; includeSubDomains" } },
    { "src": "/google1b9fe4381920a332.html", "dest": "/google1b9fe4381920a332.html", "headers": { "Content-Type": "text/html" } },
    { "src": "/([^/]+\\.json)",     "dest": "/$1",                 "headers": { "X-Content-Type-Options": "nosniff" } },
    { "src": "/(.*)",               "dest": "/index.html",         "headers": { "Cache-Control": "no-cache", "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "strict-origin-when-cross-origin", "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()", "Strict-Transport-Security": "max-age=63072000; includeSubDomains" } }
  ]
}
