{
  "version": 2,
  "builds": [
    { "src": "index.html",      "use": "@vercel/static" },
    { "src": "landing.html",    "use": "@vercel/static" },
    { "src": "impressum.html",  "use": "@vercel/static" },
    { "src": "datenschutz.html","use": "@vercel/static" },
    { "src": "robots.txt",      "use": "@vercel/static" },
    { "src": "sitemap.xml",     "use": "@vercel/static" },
    { "src": "*.json",          "use": "@vercel/static" },
    { "src": "sw.js",           "use": "@vercel/static" },
    { "src": "manifest.json",   "use": "@vercel/static" },
    { "src": "icon.svg",        "use": "@vercel/static" },
    { "src": "cities_data.js",  "use": "@vercel/static" },
    { "src": "google1b9fe4381920a332.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/sw.js",              "dest": "/sw.js" },
    { "src": "/manifest.json",      "dest": "/manifest.json" },
    { "src": "/icon.svg",           "dest": "/icon.svg" },
    { "src": "/cities_data.js",     "dest": "/cities_data.js" },
    { "src": "/robots.txt",         "dest": "/robots.txt",         "headers": { "Content-Type": "text/plain" } },
    { "src": "/sitemap.xml",        "dest": "/sitemap.xml",        "headers": { "Content-Type": "application/xml" } },
    { "src": "/",                    "dest": "/landing.html" },
    { "src": "/play",               "dest": "/index.html" },
    { "src": "/landing.html",       "dest": "/landing.html" },
    { "src": "/impressum.html",     "dest": "/impressum.html" },
    { "src": "/datenschutz.html",   "dest": "/datenschutz.html" },
    { "src": "/google1b9fe4381920a332.html", "dest": "/google1b9fe4381920a332.html", "headers": { "Content-Type": "text/html" } },
    { "src": "/([^/]+\\.json)",     "dest": "/$1" },
    { "src": "/(.*)",               "dest": "/index.html" }
  ]
}
